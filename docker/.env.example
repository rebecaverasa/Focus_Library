POSTGRES_USER=focus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=focus_library

# URLs usadas pela aplicacao para se conectar aos servicos dentro da rede do Docker.
DATABASE_URL=postgresql://focus:change-me@db:5432/focus_library
REDIS_URL=redis://redis:6379/0

# Origens (separadas por virgula) que o navegador pode usar para chamar a API (CORS).
CORS_ORIGINS=http://localhost:5173
