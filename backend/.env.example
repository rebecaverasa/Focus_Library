# Used when running the backend directly on the host (venv), against the db/redis
# containers with their ports published by docker-compose. Inside Docker, the api
# service gets DATABASE_URL/REDIS_URL from docker/.env instead (see docker/docker-compose.yml).
DATABASE_URL=postgresql://focus:change-me@localhost:5432/focus_library
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins allowed by CORS (Vite dev server by default).
CORS_ORIGINS=http://localhost:5173
# Optional: enables tests/integration (needs a real Postgres). Database name must end in _test;
# it is created and rebuilt by the tests, so never point it at the dev database.
# TEST_DATABASE_URL=postgresql://focus:change-me@localhost:5432/focus_library_test
